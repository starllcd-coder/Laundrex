DJANGO_ENV=development
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
OTP_DEBUG_RETURN_CODE=0
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Hybrid sync (desktop <-> cloud)
SYNC_ENABLED=0
SYNC_ENDPOINTS_ENABLED=0
SYNC_API_TOKEN=
CLOUD_BASE_URL=
SYNC_INTERVAL_SECONDS=120

# Security (enable for production)
SECURE_SSL_REDIRECT=0
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=0
SECURE_HSTS_PRELOAD=0
SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0

# Mobile bank transfer checkout details
BANK_TRANSFER_ENABLED=1
BANK_TRANSFER_BANK_NAME=
BANK_TRANSFER_ACCOUNT_NAME=
BANK_TRANSFER_ACCOUNT_NUMBER=
BANK_TRANSFER_IBAN=
BANK_TRANSFER_INSTRUCTIONS=Use your order number as reference and upload transfer proof if available.

# PostgreSQL
DB_NAME=laundrex
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# Central Platform connector integration
CENTRAL_PLATFORM_URL=http://127.0.0.1:8000
CENTRAL_CONNECTOR_SECRET=dev-connector-secret
CENTRAL_CONNECTOR_SIGNED=0
CENTRAL_CONNECTOR_MAX_SKEW_SECONDS=300
CENTRAL_TENANT_CODE=
CENTRAL_MODULE_CODE=laundrex
